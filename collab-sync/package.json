{
  "name": "collab-sync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "tsc",
    "server": "ts-node -r tsconfig-paths/register src/server/server.ts",
    "client": "ts-node -r tsconfig-paths/register src/client/cli.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "node-indexeddb": "^6.0.3",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/ws": "^8.5.10",
    "fake-indexeddb": "^6.2.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "verbatimModuleSyntax": false,
            "moduleResolution": "node",
            "paths": {
              "crdt-engine/*": [
                "../crdt-engine/*"
              ]
            },
            "esModuleInterop": true
          }
        }
      ]
    },
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^(\\.\\.?\\/.*)\\.js$": "$1",
      "^crdt-engine$": "<rootDir>/../crdt-engine/index.ts", 
      "^crdt-engine/(.*)$": "<rootDir>/../crdt-engine/$1"
    },
    "collectCoverageFrom": [
      "shared/**/*.ts",
      "src/server/**/*.ts"
    ]
  },
  "main": "index.ts"
}
